{
  "name": "murdoku",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.42.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "~19.2.2",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/generate-brand.cjs",
    "cases:generate": "tsx scripts/generate-cases.ts",
    "cases:refresh-clues": "tsx scripts/refresh-clues.ts",
    "format": "prettier --write App.tsx index.ts src tests scripts playwright.config.ts app.json eas.json tsconfig.json README.md",
    "test": "tsx --test tests/engine.test.ts tests/clues.test.ts",
    "test:e2e": "playwright test",
    "export": "expo export --platform all",
    "export:web": "expo export --platform web",
    "preview": "node scripts/preview.cjs",
    "preview:test": "npm run export:web && npm run preview",
    "build:android": "npx eas-cli build --platform android --profile preview",
    "build:ios": "npx eas-cli build --platform ios --profile preview"
  },
  "private": true
}
